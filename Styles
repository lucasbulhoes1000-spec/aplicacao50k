/* =====================================================================
   styles.css — Operação 50K / Instituto Bulhões
   Paleta: bege #CCBCA6, dourado-taupe #A18B6C, off-white #EFEFED
   Tipografia: system font stack (serif para títulos, sans para corpo)
   ===================================================================== */

:root {
  --color-bg: #EFEFED;
  --color-bg-alt: #E4DCCB;
  --color-surface: #FFFFFF;
  --color-ink: #211D17;
  --color-ink-soft: #4A4438;
  --color-accent: #A18B6C;
  --color-accent-strong: #6B5A3E;
  --color-beige: #CCBCA6;
  --color-border: #DBD3C4;
  --color-error: #8B3A3A;

  --font-serif: ui-serif, Georgia, "Iowan Old Style", "Palatino Linotype", "URW Palladio", serif;
  --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;

  --container-max: 600px;
  --space-1: 8px;
  --space-2: 16px;
  --space-3: 24px;
  --space-4: 32px;
  --space-5: 48px;
  --space-6: 64px;
  --radius: 3px;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--color-bg);
  color: var(--color-ink);
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 1.5;
}

img { max-width: 100%; display: block; }

.container {
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 0 var(--space-3);
}

.section {
  padding: var(--space-6) 0;
}

.section--alt {
  background: var(--color-bg-alt);
}

.section--surface {
  background: var(--color-surface);
}

.section--ink {
  background: var(--color-ink);
  color: var(--color-bg);
}

.section--ink .eyebrow,
.section--ink h2 {
  color: var(--color-bg);
}

.eyebrow {
  font-size: 0.8125rem;
  letter-spacing: 0.03em;
  color: var(--color-accent-strong);
  font-weight: 600;
  margin: 0 0 var(--space-2);
}

h1, h2, h3 {
  font-family: var(--font-serif);
  font-weight: 500;
  line-height: 1.2;
  margin: 0 0 var(--space-3);
  color: var(--color-ink);
}

h1 { font-size: clamp(2rem, 7vw, 2.75rem); line-height: 1.15; }
h2 { font-size: clamp(1.5rem, 5vw, 1.875rem); }
h3 { font-size: 1.25rem; margin-bottom: var(--space-2); }

p { margin: 0 0 var(--space-2); color: var(--color-ink-soft); }

.lede {
  font-size: 1.125rem;
  color: var(--color-ink-soft);
}

ul.plain, ol.plain {
  margin: 0 0 var(--space-2);
  padding-left: 0;
  list-style: none;
}

.hr {
  border: none;
  border-top: 1px solid var(--color-border);
  margin: var(--space-4) 0;
}

/* ---------- HERO ---------- */
.hero {
  padding: var(--space-5) 0 var(--space-6);
  text-align: left;
}

.hero-logo {
  width: 56px;
  height: 56px;
  margin-bottom: var(--space-3);
}

.hero .lede {
  margin-bottom: var(--space-4);
}

.hero-note {
  font-size: 0.875rem;
  color: var(--color-ink-soft);
  margin-top: var(--space-2);
}

/* ---------- LISTS WITH LEADING RULE ---------- */
.check-list {
  margin: 0 0 var(--space-3);
  padding: 0;
  list-style: none;
}

.check-list li {
  padding: var(--space-2) 0;
  border-top: 1px solid var(--color-border);
  color: var(--color-ink);
}

.check-list li:last-child {
  border-bottom: 1px solid var(--color-border);
}

/* ---------- COMPARISON PANEL ---------- */
.compare {
  display: grid;
  gap: var(--space-3);
  margin: var(--space-3) 0;
}

.compare-col {
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: var(--space-3);
  background: var(--color-surface);
}

.compare-col h4 {
  font-family: var(--font-serif);
  font-size: 1.0625rem;
  margin: 0 0 var(--space-2);
  color: var(--color-ink);
}

.compare-col--accent {
  border-color: var(--color-accent);
  border-width: 2px;
}

/* ---------- PULL QUOTE ---------- */
.pull-quote {
  border-left: 3px solid var(--color-accent);
  padding: var(--space-2) 0 var(--space-2) var(--space-3);
  margin: var(--space-4) 0;
  font-family: var(--font-serif);
  font-size: 1.1875rem;
  color: var(--color-ink);
  font-style: italic;
}

/* ---------- MECHANISM PILLARS ---------- */
.pillars {
  list-style: none;
  margin: var(--space-3) 0;
  padding: 0;
  border-left: 2px solid var(--color-border);
}

.pillar {
  position: relative;
  padding: 0 0 var(--space-4) var(--space-3);
}

.pillar::before {
  content: "";
  position: absolute;
  left: -5px;
  top: 6px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--color-accent);
}

.pillar h4 {
  font-family: var(--font-serif);
  font-size: 1.0625rem;
  margin: 0 0 4px;
  color: var(--color-ink);
}

.pillar p { margin: 0; }

/* ---------- NUMBERED PROGRAM STEPS (sequência real) ---------- */
.program-steps {
  list-style: none;
  counter-reset: program;
  margin: var(--space-3) 0;
  padding: 0;
}

.program-steps li {
  counter-increment: program;
  display: flex;
  gap: var(--space-2);
  padding: var(--space-2) 0;
  border-top: 1px solid var(--color-border);
}

.program-steps li:last-child { border-bottom: 1px solid var(--color-border); }

.program-steps li::before {
  content: counter(program);
  font-family: var(--font-serif);
  font-size: 0.9375rem;
  color: var(--color-accent-strong);
  min-width: 1.5em;
  flex-shrink: 0;
}

/* ---------- FAQ (native details/summary — zero JS) ---------- */
.faq-item {
  border-top: 1px solid var(--color-border);
}

.faq-item:last-child { border-bottom: 1px solid var(--color-border); }

.faq-item summary {
  cursor: pointer;
  padding: var(--space-2) 0;
  font-weight: 600;
  font-family: var(--font-serif);
  color: var(--color-ink);
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-2);
}

.faq-item summary::-webkit-details-marker { display: none; }

.faq-item summary::after {
  content: "+";
  font-size: 1.25rem;
  color: var(--color-accent-strong);
  flex-shrink: 0;
}

.faq-item[open] summary::after {
  content: "–";
}

.faq-item p {
  padding-bottom: var(--space-2);
}

.faq-item summary:focus-visible {
  outline: 2px solid var(--color-accent-strong);
  outline-offset: 2px;
}

/* ---------- BUTTONS / CTA ---------- */
.btn {
  display: inline-block;
  font-family: var(--font-sans);
  font-size: 1rem;
  font-weight: 600;
  padding: 14px 28px;
  border-radius: var(--radius);
  border: 1px solid transparent;
  cursor: pointer;
  text-decoration: none;
  text-align: center;
}

.btn-primary {
  background: var(--color-accent-strong);
  color: #FFFFFF;
}

.btn-primary:hover { background: #58492F; }

.btn-primary:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.cta-block {
  text-align: left;
  margin-top: var(--space-3);
}

/* ---------- AUTHORITY / FOOTER ---------- */
.authority-block {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-3);
}

.placeholder-note {
  font-size: 0.8125rem;
  color: var(--color-ink-soft);
  border: 1px dashed var(--color-border);
  border-radius: var(--radius);
  padding: var(--space-2);
  margin-top: var(--space-2);
}

footer.site-footer {
  padding: var(--space-4) 0 var(--space-6);
  font-size: 0.8125rem;
  color: var(--color-ink-soft);
}

/* =====================================================================
   FUNIL DE APLICAÇÃO — componentes do motor (app.js)
   ===================================================================== */

#aplicacao { scroll-margin-top: var(--space-3); }

.funnel-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: var(--space-4) var(--space-3);
}

.funnel-progress { margin-bottom: var(--space-4); }

.funnel-progress-track {
  height: 6px;
  background: var(--color-bg-alt);
  border-radius: 999px;
  overflow: hidden;
}

.funnel-progress-fill {
  height: 100%;
  background: var(--color-accent-strong);
  transition: width 0.25s ease;
}

@media (prefers-reduced-motion: reduce) {
  .funnel-progress-fill { transition: none; }
}

.funnel-progress-label {
  margin: var(--space-1) 0 0;
  font-size: 0.8125rem;
  color: var(--color-ink-soft);
}

.funnel-step-title {
  margin-bottom: var(--space-3);
}

.funnel-field {
  margin-bottom: var(--space-3);
}

.funnel-label {
  display: block;
  font-weight: 600;
  margin-bottom: 6px;
  color: var(--color-ink);
}

.funnel-hint {
  font-size: 0.8125rem;
  color: var(--color-ink-soft);
  margin: 0 0 6px;
}

.funnel-input {
  width: 100%;
  font-family: var(--font-sans);
  font-size: 1rem;
  padding: 12px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  background: var(--color-surface);
  color: var(--color-ink);
}

.funnel-input:focus-visible,
.faq-item a:focus-visible,
.btn:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
button:focus-visible,
a:focus-visible {
  outline: 2px solid var(--color-accent-strong);
  outline-offset: 2px;
}

.funnel-textarea { resize: vertical; min-height: 80px; }

.funnel-radio-group { display: flex; flex-direction: column; gap: 10px; }

.funnel-radio-option {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: 12px;
}

.funnel-radio-option input { margin-top: 3px; }

.funnel-radio-option label { color: var(--color-ink); }

.funnel-field-error .funnel-input {
  border-color: var(--color-error);
}

.funnel-field-error-msg {
  color: var(--color-error);
  font-size: 0.875rem;
  margin: 6px 0 0;
}

.funnel-error-summary {
  margin-bottom: var(--space-3);
}

.funnel-error-summary:empty { display: none; }

.funnel-error-summary-title {
  color: var(--color-error);
  font-weight: 600;
  margin-bottom: 6px;
}

.funnel-error-summary ul {
  margin: 0;
  padding-left: var(--space-3);
}

.funnel-error-summary a { color: var(--color-error); }

.funnel-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-2);
  margin-top: var(--space-4);
}

.funnel-btn {
  font-family: var(--font-sans);
  font-size: 1rem;
  font-weight: 600;
  padding: 14px 24px;
  border-radius: var(--radius);
  border: 1px solid transparent;
  cursor: pointer;
}

.funnel-btn-primary {
  background: var(--color-accent-strong);
  color: #FFFFFF;
  margin-left: auto;
}

.funnel-btn-primary:hover { background: #58492F; }

.funnel-btn-ghost {
  background: transparent;
  color: var(--color-ink);
  border-color: var(--color-border);
}

.funnel-trust-item {
  padding: var(--space-2) 0;
  border-top: 1px solid var(--color-border);
}

.funnel-trust-item:last-child { border-bottom: 1px solid var(--color-border); }

.funnel-trust-privacy { font-size: 0.875rem; }

.funnel-review-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: var(--space-2);
  padding: var(--space-2) 0;
  border-top: 1px solid var(--color-border);
}

.funnel-review-row:last-child { border-bottom: 1px solid var(--color-border); }

.funnel-review-label { color: var(--color-ink-soft); font-size: 0.875rem; flex: 1 1 140px; }

.funnel-review-value { color: var(--color-ink); font-weight: 600; flex: 1 1 140px; }

.funnel-review-edit {
  background: none;
  border: none;
  color: var(--color-accent-strong);
  text-decoration: underline;
  cursor: pointer;
  font-size: 0.875rem;
  padding: 0;
}

.funnel-success-message { margin-bottom: var(--space-3); }

.funnel-success-list {
  margin: 0;
  padding-left: var(--space-3);
}

.funnel-success-list li { margin-bottom: var(--space-2); color: var(--color-ink-soft); }

.funnel-resume {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: var(--space-3);
}

.funnel-resume-actions {
  display: flex;
  gap: var(--space-2);
  margin-top: var(--space-2);
  flex-wrap: wrap;
}

/* =====================================================================
   RESPONSIVE
   ===================================================================== */
@media (min-width: 560px) {
  .compare { grid-template-columns: 1fr 1fr; }
}
